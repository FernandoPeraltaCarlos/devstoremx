---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import SiteFrame from '../../components/content/SiteFrame.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { formatDate } from '../../lib/seo';
import { readingMinutes } from '../../lib/blog';

const posts = (await getCollection('blog')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() || a.id.localeCompare(b.id, 'es'));
const featured = posts.find((post) => post.id === 'como-hacer-una-pagina-web') ?? posts[0];
const rest = posts.filter((post) => post.id !== featured?.id);
const title = 'Blog de desarrollo web y tiendas en línea | Devstoremx';
const description = 'Entradas de blog en español para hacer una página web, calcular qué encarece un proyecto, comparar Shopify y WordPress, y elegir agencia. Sin precios de lista.';
const crumbs = [{ name: 'Inicio', href: '/' }, { name: 'Blog', href: '/blog' }];
---
<BaseLayout title={title} description={description} image={featured?.data.heroImage} imageAlt={featured?.data.heroImageAlt}>
  <StructuredData slot="head" title={title} description={description} variant="page" breadcrumbs={crumbs}
    image={featured?.data.heroImage} imageAlt={featured?.data.heroImageAlt}
    blogPosts={posts.map((post) => ({ headline: post.data.h1, href: `/blog/${post.id}`, datePublished: post.data.publishedAt, authorSlug: post.data.author, image: post.data.heroImage }))} />
  <SiteFrame>
    <div class="blog-home">
      <header class="blog-width blog-intro">
        <nav aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Blog</span></nav>
        <div class="blog-intro-heading"><h1>Ideas para construir<br />mejor en la web.</h1><p>Entradas de blog sobre páginas web, tiendas en línea y las decisiones que hacen la diferencia en tu proyecto. Por Fernando Peralta.</p></div>
      </header>
      {featured && (
        <section class="blog-width" aria-labelledby="entrada-destacada">
          <article class="featured-post">
            <a href={`/blog/${featured.id}`} class="featured-image" tabindex="-1" aria-hidden="true"><img src={featured.data.heroImage} alt="" width="1200" height="630" loading="eager" fetchpriority="high" /></a>
            <div class="featured-copy">
              <p class="featured-category">{featured.data.category}</p>
              <h2 id="entrada-destacada"><a href={`/blog/${featured.id}`}>{featured.data.h1}</a></h2>
              <p class="featured-description">De la primera idea a un sitio publicado: qué decidir, qué preparar y cuándo pedir ayuda.</p>
              <div class="featured-author"><img src="/team/fernando-peralta.jpg" alt="" width="40" height="40" /><div><span>Fernando Peralta</span><p><time datetime={featured.data.publishedAt.toISOString()}>{formatDate(featured.data.publishedAt)}</time><span>{readingMinutes(featured.body)} min de lectura</span></p></div></div>
              <a href={`/blog/${featured.id}`} class="featured-link">Leer la entrada <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        </section>
      )}
      <section class="blog-width all-posts" aria-labelledby="todas-las-entradas">
        <div class="all-posts-heading"><h2 id="todas-las-entradas">Más entradas de blog</h2><a href="/rss.xml">Suscríbete por RSS</a></div>
        <div class="posts-grid">{rest.map((post) => <PostCard post={post} />)}</div>
      </section>
      <aside class="blog-width blog-contact"><div><h2>De la lectura a tu próximo proyecto.</h2><p>Cuéntanos qué quieres construir. Lo revisamos contigo.</p></div><a href="/#contacto" class="button button-primary">Hablemos de tu proyecto</a></aside>
    </div>
  </SiteFrame>
</BaseLayout>
<style>
  .blog-home { background: #fff; padding-bottom: 80px; }
  .blog-width { width: min(1200px, calc(100% - 80px)); margin-inline: auto; }
  .blog-intro { padding-top: 32px; }
  .blog-intro nav { display: flex; gap: 10px; font-size: 12px; color: var(--color-muted); }
  .blog-intro-heading { display: flex; align-items: end; justify-content: space-between; gap: 48px; padding-block: 48px; }
  h1 { font-size: clamp(38px, 4.4vw, 60px); line-height: 1.12; letter-spacing: -.045em; font-weight: 750; }
  .blog-intro-heading > p { max-width: 390px; font-size: 15px; line-height: 1.85; color: var(--color-muted); }
  .featured-post { display: grid; grid-template-columns: 1.25fr 1fr; border-radius: 12px; overflow: hidden; background: var(--color-paper); }
  .featured-image { display: block; min-height: 400px; }
  .featured-image > img { width: 100%; height: 100%; object-fit: cover; }
  .featured-copy { align-self: center; padding: 40px; }
  .featured-category { font-size: 13px; font-weight: 700; color: var(--color-brand); }
  .featured-copy h2 { margin-top: 16px; font-size: clamp(28px, 3vw, 38px); line-height: 1.2; letter-spacing: -.035em; font-weight: 700; }
  h2 a:hover { color: var(--color-brand); }
  .featured-description { margin-top: 18px; font-size: 15px; line-height: 1.85; color: var(--color-muted); }
  .featured-author { display: flex; align-items: center; gap: 12px; margin-top: 28px; }
  .featured-author > img { border-radius: 50%; object-fit: cover; }
  .featured-author > div > span { font-size: 12px; font-weight: 700; }
  .featured-author p { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 11px; line-height: 1.8; color: var(--color-muted); }
  .featured-link { display: inline-flex; align-items: center; gap: 18px; margin-top: 28px; color: var(--color-brand); font-size: 14px; font-weight: 700; }
  .featured-link > span { font-size: 20px; }
  .all-posts { padding-block: 64px; }
  .all-posts-heading { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: center; gap: 16px; margin-bottom: 32px; }
  .all-posts-heading h2 { font-size: 28px; font-weight: 700; letter-spacing: -.03em; }
  .all-posts-heading a { font-size: 12px; font-weight: 600; color: var(--color-brand); }
  .posts-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 32px; }
  .blog-contact { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px; padding: 32px; border-radius: 12px; background: var(--color-primary-soft); }
  .blog-contact h2 { font-size: 23px; font-weight: 700; letter-spacing: -.025em; }
  .blog-contact p { margin-top: 10px; font-size: 14px; color: var(--color-muted); }
  @media (max-width: 900px) {
    .blog-intro-heading { align-items: start; flex-direction: column; gap: 24px; }
    .blog-intro-heading > p { max-width: 560px; }
    .featured-post { grid-template-columns: 1fr 1fr; }
    .featured-copy { padding: 28px; }
    .posts-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .blog-width { width: calc(100% - 40px); }
    .blog-intro { padding-top: 24px; }
    .blog-intro-heading { padding-block: 36px; }
    .featured-post { grid-template-columns: 1fr; }
    .featured-image { min-height: 0; aspect-ratio: 1200 / 630; }
    .featured-copy { padding: 26px; }
    .all-posts { padding-block: 44px; }
    .all-posts-heading h2 { font-size: 25px; }
    .posts-grid { grid-template-columns: 1fr; gap: 36px; }
    .blog-contact { padding: 24px; }
    .blog-contact h2 { font-size: 21px; }
  }
</style>
