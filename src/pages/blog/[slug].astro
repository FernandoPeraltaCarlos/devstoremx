---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import SiteFrame from '../../components/content/SiteFrame.astro';
import PageHero from '../../components/content/PageHero.astro';
import Button from '../../components/ui/Button.astro';
import Contact from '../../components/sections/Contact.astro';
import { memberSlug, team } from '../../data/landing';
import { formatDate } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { id: post.id } }));
}

const { id } = Astro.props;
const posts = await getCollection('blog');
const post = posts.find((item) => item.id === id);
if (!post) throw new Error(`Guía no encontrada: ${id}`);
const { Content } = await render(post);
const author = team.find((member) => memberSlug(member.image) === post.data.author);
if (!author) throw new Error(`Autor no encontrado: ${post.data.author}`);
const service = (await getCollection('servicios')).find((item) => item.id === post.data.relatedService);
const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Guías', href: '/blog' },
  { name: post.data.title, href: `/blog/${post.id}` },
];
const more = posts.filter((item) => item.id !== post.id).slice(0, 3);
---
<BaseLayout
  title={post.data.metaTitle}
  description={post.data.metaDescription}
  ogType="article"
  image={post.data.heroImage}
  publishedTime={post.data.publishedAt.toISOString()}
  modifiedTime={post.data.updatedAt.toISOString()}
>
  <StructuredData
    slot="head"
    title={post.data.metaTitle}
    description={post.data.metaDescription}
    variant="article"
    breadcrumbs={crumbs}
    article={{
      headline: post.data.h1,
      datePublished: post.data.publishedAt,
      dateModified: post.data.updatedAt,
      authorSlug: post.data.author,
      image: post.data.heroImage,
    }}
    howTo={post.data.howTo}
  />
  <SiteFrame>
    <PageHero crumbs={crumbs} title={post.data.h1} lede={post.data.intro}>
      <p slot="meta" class="text-sm leading-6 text-muted-dark">
        Por <a href={`/equipo/${post.data.author}`} class="font-semibold text-cloud underline decoration-[#56627a] underline-offset-4 hover:text-periwinkle">{author.name}</a>
        <span aria-hidden="true"> · </span>
        <span>Última actualización: {formatDate(post.data.updatedAt)}</span>
      </p>
    </PageHero>
    <article class="section-space bg-paper">
      <div class="container-page flex flex-col gap-12">
        {post.data.howTo && (
          <section class="max-w-[72ch]" aria-labelledby="pasos">
            <h2 id="pasos" class="text-[28px] leading-[1.2] font-bold tracking-[-0.02em] sm:text-[32px]">{post.data.howTo.name}</h2>
            <p class="mt-4 text-base leading-7 text-muted">{post.data.howTo.description}</p>
            <ol class="mt-6 list-decimal space-y-4 pl-5 text-base leading-7 text-muted">
              {post.data.howTo.steps.map((step) => (
                <li><strong class="text-ink">{step.name}.</strong> {step.text}</li>
              ))}
            </ol>
          </section>
        )}
        <div class="rich-text"><Content /></div>
        {service && (
          <aside class="max-w-[72ch] border-t border-line pt-8">
            <h2 class="text-2xl font-bold tracking-[-0.02em]">Si prefieres que lo hagamos nosotros</h2>
            <p class="mt-3 text-base leading-7 text-muted">{service.data.intro}</p>
            <Button href={`/${service.id}`} class="mt-6">Ver {service.data.title}</Button>
          </aside>
        )}
        <p class="max-w-[72ch] text-sm leading-6 text-muted">Última actualización: {formatDate(post.data.updatedAt)}. Escrito por <a href={`/equipo/${post.data.author}`} class="font-semibold text-brand">{author.name}</a>, {author.role} de Devstoremx.</p>
      </div>
    </article>
    {more.length > 0 && (
      <section class="section-space bg-surface-sunken" aria-labelledby="mas-guias">
        <div class="container-page">
          <h2 id="mas-guias" class="text-[32px] font-bold tracking-[-0.025em]">Otras guías</h2>
          <ul class="mt-8 grid gap-x-10 sm:grid-cols-3">
            {more.map((item) => (
              <li class="border-t border-line py-6">
                <a href={`/blog/${item.id}`} class="text-xl font-semibold hover:text-brand">{item.data.title}</a>
                <p class="mt-2 text-[15px] leading-6 text-muted">{item.data.metaDescription}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
    <Contact />
  </SiteFrame>
</BaseLayout>
