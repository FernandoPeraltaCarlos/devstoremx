---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import SiteFrame from '../../components/content/SiteFrame.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { authorPath } from '../../data/authors';
import { memberSlug, team } from '../../data/landing';
import { formatDate } from '../../lib/seo';
import { readingMinutes } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { id: post.id } }));
}

const { id } = Astro.props;
const posts = await getCollection('blog');
const post = posts.find((item) => item.id === id);
if (!post) throw new Error(`Entrada de blog no encontrada: ${id}`);
const { Content, headings } = await render(post);
const author = team.find((member) => memberSlug(member.image) === post.data.author);
if (!author) throw new Error(`Autor no encontrado: ${post.data.author}`);
const authorHref = authorPath(post.data.author);
const servicios = await getCollection('servicios');
const serviceIds = [...new Set([post.data.relatedService, ...post.data.relatedServices])];
const linkedServices = serviceIds.flatMap((serviceId) => {
  const match = servicios.find((item) => item.id === serviceId);
  return match ? [match] : [];
});
const service = linkedServices.find((item) => item.id === post.data.relatedService);
function sharesTopic(item: (typeof posts)[number]) {
  const ids = new Set([item.data.relatedService, ...item.data.relatedServices]);
  return serviceIds.some((serviceId) => ids.has(serviceId));
}
const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: post.data.title, href: `/blog/${post.id}` },
];
const sections = headings.filter((heading) => heading.depth === 2);
const more = posts.filter((item) => item.id !== post.id)
  .sort((a, b) => Number(sharesTopic(b)) - Number(sharesTopic(a)) || b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---
<BaseLayout title={post.data.metaTitle} description={post.data.metaDescription} ogType="article"
  image={post.data.heroImage} imageAlt={post.data.heroImageAlt}
  publishedTime={post.data.publishedAt.toISOString()} modifiedTime={post.data.updatedAt.toISOString()}>
  <StructuredData slot="head" title={post.data.metaTitle} description={post.data.metaDescription}
    image={post.data.heroImage} imageAlt={post.data.heroImageAlt}
    variant="article" breadcrumbs={crumbs}
    article={{ headline: post.data.h1, datePublished: post.data.publishedAt, dateModified: post.data.updatedAt, authorSlug: post.data.author, image: post.data.heroImage }}
    faqs={post.data.faqs} />
  <SiteFrame>
    <article class="blog-article">
      <header class="article-header blog-width">
        <nav class="article-breadcrumb" aria-label="Ruta de navegación">
          <a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/blog">Blog</a><span aria-hidden="true">/</span><span aria-current="page">{post.data.title}</span>
        </nav>
        <div class="article-heading">
          <p class="article-category">{post.data.category}</p>
          <h1>{post.data.h1}</h1>
           <p class="article-intro">{post.data.intro}</p>
           <a class="article-intro-contact" href="/#contacto">{post.data.cta.label}</a>
          <div class="article-byline">
            <div class="author-identity">
              <img src={author.image} alt="" width="48" height="48" class="author-avatar" />
              <div><p class="author-name">{authorHref ? <a href={authorHref} rel="author">{author.name}</a> : author.name}</p><p class="author-role">{author.role} en Devstoremx</p></div>
            </div>
            <div class="article-dates">
              <p><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time></p>
              <p>{readingMinutes(post.body)} min de lectura</p>
            </div>
          </div>
        </div>
        <figure class="article-cover">
          <img src={post.data.heroImage} alt={post.data.heroImageAlt} width="1200" height="630" loading="eager" fetchpriority="high" />
          <figcaption>{post.data.heroImageAlt} <span>Ilustración editorial.</span></figcaption>
        </figure>
      </header>
      <div class="article-layout blog-width">
        <aside class="article-sidebar" aria-label="Índice del artículo">
          <details open class="article-toc">
            <summary>En esta entrada</summary>
            <nav aria-label="Secciones de la entrada">
              <ul>
                {sections.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
                {post.data.faqs.length > 0 && <li><a href="#preguntas">Preguntas frecuentes</a></li>}
              </ul>
            </nav>
          </details>
          <a href="/blog" class="back-to-blog">Volver al blog</a>
        </aside>
        <div class="article-main">
          <div class="article-prose"><Content /></div>
          <footer class="article-end">
            <p class="article-updated">Última actualización: <time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt)}</time></p>
            <div class="author-note">
              <img src={author.image} alt="" width="64" height="64" class="author-avatar" loading="lazy" />
              <div><p class="author-note-label">Escrito por</p><p class="author-name">{authorHref ? <a href={authorHref} rel="author">{author.name}</a> : author.name}</p><p class="author-description">{author.bio}</p>{authorHref && <a class="author-profile-link" href={authorHref}>Ver el perfil y la experiencia de {author.name}</a>}</div>
            </div>
          </footer>
          {post.data.faqs.length > 0 && (
            <section class="article-faq" aria-labelledby="preguntas">
              <h2 id="preguntas">Preguntas frecuentes</h2>
              {post.data.faqs.map((faq) => (
                <div>
                  <h3>{faq.question}</h3>
                  <p>{faq.answer}</p>
                </div>
              ))}
            </section>
          )}
          {service && (
            <aside class="article-service" aria-labelledby="siguiente-paso">
              <h2 id="siguiente-paso">{post.data.cta.title}</h2>
              <p>{post.data.cta.description}</p>
              <a class="article-contact" href="/#contacto">{post.data.cta.label}</a>
              <a href={`/${service.id}`}>Conoce el servicio de {service.data.title}</a>
              {linkedServices.length > 1 && (
                <ul>
                  {linkedServices.filter((item) => item.id !== service.id).map((item) => (
                    <li><a href={`/${item.id}`}>{item.data.title}</a></li>
                  ))}
                </ul>
              )}
            </aside>
          )}
        </div>
      </div>
    </article>
    {more.length > 0 && (
      <section class="article-related" aria-labelledby="mas-entradas">
        <div class="blog-width">
          <div class="related-heading"><h2 id="mas-entradas">Sigue leyendo</h2><a href="/blog">Todas las entradas</a></div>
          <div class="related-grid">{more.map((item) => <PostCard post={item} />)}</div>
        </div>
      </section>
    )}
  </SiteFrame>
</BaseLayout>
<style>
  .blog-article { background: #fff; }
  .blog-width { width: min(1200px, calc(100% - 80px)); margin-inline: auto; }
  .article-header { padding-top: 32px; }
  .article-breadcrumb { display: flex; flex-wrap: wrap; gap: 10px; font-size: 12px; color: var(--color-muted); }
  .article-breadcrumb a:hover { color: var(--color-brand); }
  .article-heading { max-width: 860px; margin: 56px auto 40px; }
  .article-category { color: var(--color-brand); font-size: 14px; font-weight: 700; }
  h1 { margin-top: 18px; font-size: clamp(36px, 4.5vw, 62px); line-height: 1.12; letter-spacing: -.045em; font-weight: 750; text-wrap: balance; }
  .article-intro { margin-top: 24px; max-width: 780px; font-size: 18px; line-height: 1.85; color: var(--color-muted); }
  .article-intro-contact { display: inline-block; margin-top: 20px; padding-block: 10px; color: var(--color-brand); font-size: 15px; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  .article-byline { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--color-line); }
  .author-identity { display: flex; align-items: center; gap: 12px; }
  .author-avatar { border-radius: 50%; object-fit: cover; flex: none; }
  .author-name { font-size: 14px; font-weight: 700; }
  .author-name a:hover, .author-profile-link:hover { color: var(--color-brand); }
  .author-profile-link { display: inline-block; margin-top: 10px; padding-block: 6px; font-size: 13px; font-weight: 600; color: var(--color-brand); text-decoration: underline; text-underline-offset: 4px; }
  .author-role, .article-dates { font-size: 12px; line-height: 1.8; color: var(--color-muted); }
  .article-dates { text-align: right; }
  .article-cover > img { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; border-radius: 12px; background: var(--color-surface-sunken); }
  figcaption { margin-top: 12px; font-size: 11px; line-height: 1.7; color: var(--color-muted); }
  figcaption span { display: block; }
  .article-layout { display: grid; grid-template-columns: 225px minmax(0, 720px); justify-content: space-between; gap: 64px; padding-top: 64px; padding-bottom: 80px; align-items: start; }
  .article-sidebar { position: sticky; top: 32px; font-size: 12px; }
  .article-toc summary { font-size: 14px; font-weight: 700; cursor: pointer; }
  .article-toc ul { margin-top: 18px; border-left: 2px solid var(--color-line); padding-left: 18px; list-style: none; }
  .article-toc li + li { margin-top: 14px; }
  .article-toc a { display: block; line-height: 1.65; color: var(--color-muted); }
  .article-toc a:hover { color: var(--color-brand); }
  .back-to-blog { display: inline-block; margin-top: 28px; font-weight: 600; color: var(--color-brand); }
  .article-main { min-width: 0; }
  .article-prose { font-family: var(--font-sans); font-size: 19px; line-height: 1.9; color: #303b50; overflow-wrap: break-word; }
  .article-prose :global(h2) { margin: 48px 0 20px; font-family: var(--font-sans); font-size: 28px; line-height: 1.35; letter-spacing: -.025em; font-weight: 700; color: var(--color-ink); scroll-margin-top: 28px; }
  .article-prose :global(h2:first-child) { margin-top: 0; }
  .article-prose :global(h3) { margin: 32px 0 14px; font-family: var(--font-sans); font-size: 22px; line-height: 1.4; font-weight: 700; color: var(--color-ink); }
  .article-prose :global(p + p) { margin-top: 22px; }
  .article-prose :global(a) { color: var(--color-brand); text-decoration: underline; text-decoration-color: #bcc6f5; text-underline-offset: 4px; }
  .article-prose :global(a:hover) { text-decoration-color: var(--color-brand); }
  .article-prose :global(strong) { font-weight: 700; color: var(--color-ink); }
  .article-prose :global(ul), .article-prose :global(ol) { margin-block: 22px; padding-left: 24px; list-style: disc; }
  .article-prose :global(ol) { list-style: decimal; }
  .article-prose :global(li + li) { margin-top: 10px; }
  .article-prose :global(table) { display: block; max-width: 100%; overflow-x: auto; margin-block: 28px; border-collapse: collapse; font-family: var(--font-sans); font-size: 14px; line-height: 1.65; }
  .article-prose :global(th), .article-prose :global(td) { border-bottom: 1px solid var(--color-line); padding: 16px; min-width: 150px; text-align: left; vertical-align: top; }
  .article-prose :global(th) { background: var(--color-paper); color: var(--color-ink); font-weight: 700; }
  .article-end { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--color-line); }
  .article-updated { font-size: 12px; color: var(--color-muted); }
  .author-note { display: flex; gap: 18px; margin-top: 28px; align-items: start; }
  .author-note-label { font-size: 11px; margin-bottom: 4px; color: var(--color-muted); }
  .author-description { margin-top: 8px; font-size: 13px; line-height: 1.8; color: var(--color-muted); }
  .article-service { margin-top: 40px; padding: 28px; border-radius: 10px; background: var(--color-primary-soft); }
  .article-service h2 { font-size: 21px; font-weight: 700; letter-spacing: -.02em; }
  .article-service p { margin-top: 12px; font-size: 14px; line-height: 1.8; color: var(--color-muted); }
  .article-service a { display: inline-block; margin-top: 18px; font-size: 14px; line-height: 1.6; color: var(--color-brand); font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  .article-service .article-contact { display: block; width: fit-content; max-width: 100%; border-radius: 6px; background: var(--color-brand); color: white; padding: 14px 20px; text-decoration: none; }
  .article-service .article-contact:hover { background: #2f47cc; }
  .article-service ul { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 14px; padding: 0; list-style: none; }
  .article-service li a { margin-top: 0; font-weight: 600; }
  .article-faq { margin-top: 48px; }
  .article-faq h2 { font-size: 28px; line-height: 1.35; letter-spacing: -.025em; font-weight: 700; scroll-margin-top: 28px; }
  .article-faq h3 { margin-top: 28px; font-size: 18px; line-height: 1.45; font-weight: 700; }
  .article-faq p { margin-top: 8px; font-size: 16px; line-height: 1.8; color: var(--color-muted); }
  .article-related { background: var(--color-paper); padding-block: 64px 80px; }
  .related-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 32px; }
  .related-heading h2 { font-size: 30px; font-weight: 700; letter-spacing: -.03em; }
  .related-heading a { color: var(--color-brand); font-size: 13px; font-weight: 600; }
  .related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  @media (min-width: 1250px) { .article-layout { padding-right: 80px; } }
  @media (max-width: 900px) {
    .article-layout { grid-template-columns: minmax(0, 720px); justify-content: center; gap: 36px; padding-top: 36px; }
    .article-sidebar { position: static; padding-bottom: 24px; border-bottom: 1px solid var(--color-line); }
    .article-toc ul { columns: 2; column-gap: 28px; }
    .article-toc li { break-inside: avoid; }
    .article-toc li + li { margin-top: 10px; }
    .back-to-blog { display: none; }
    .related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .blog-width { width: calc(100% - 40px); }
    .article-header { padding-top: 24px; }
    .article-heading { margin-top: 36px; margin-bottom: 28px; }
    h1 { font-size: 36px; }
    .article-intro { font-size: 16px; line-height: 1.8; }
    .article-byline { align-items: start; gap: 16px; }
    .article-dates { text-align: left; padding-left: 60px; }
    .article-toc ul { columns: 1; }
    .article-prose { font-size: 18px; line-height: 1.85; }
    .article-prose :global(h2) { font-size: 25px; }
    .article-service { padding: 22px; }
    .related-grid { grid-template-columns: 1fr; gap: 36px; }
    .article-related { padding-block: 44px 56px; }
  }
</style>
