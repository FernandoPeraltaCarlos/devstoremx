---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import SiteFrame from '../../components/content/SiteFrame.astro';
import PageHero from '../../components/content/PageHero.astro';
import { memberSlug, publicValue, team } from '../../data/landing';
import { formatDate } from '../../lib/seo';

export function getStaticPaths() {
  return team.map((member) => ({ params: { slug: memberSlug(member.image) } }));
}

const member = team.find((item) => memberSlug(item.image) === Astro.params.slug);
if (!member) throw new Error('Perfil no encontrado');
const slug = memberSlug(member.image);
const posts = (await getCollection('blog'))
  .filter((post) => post.data.author === slug)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const title = `${member.name}, ${member.role} | Devstoremx`;
const description = member.bio;
const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: member.name, href: `/equipo/${slug}` },
];
const links = [publicValue(member.linkedin), publicValue(member.portfolio)].filter((link): link is string => Boolean(link));
---
<BaseLayout title={title} description={description}>
  <StructuredData slot="head" title={title} description={description} variant="author" authorSlug={slug} breadcrumbs={crumbs} />
  <SiteFrame>
    <PageHero crumbs={crumbs} title={member.name} lede={member.bio}>
      <p slot="meta" class="text-sm font-semibold tracking-[-0.01em] text-periwinkle">{member.role} en Devstoremx</p>
      {links.length > 0 && (
        <ul class="flex flex-wrap gap-4">
          {publicValue(member.linkedin) && <li><a rel="me" href={member.linkedin} class="font-semibold text-cloud underline decoration-[#56627a] underline-offset-4 hover:text-periwinkle">LinkedIn</a></li>}
          {publicValue(member.portfolio) && <li><a rel="me" href={member.portfolio} class="font-semibold text-cloud underline decoration-[#56627a] underline-offset-4 hover:text-periwinkle">Sitio personal</a></li>}
        </ul>
      )}
    </PageHero>
    <section class="section-space bg-paper">
      <div class="container-page max-w-[880px]">
        <h2 class="text-[32px] font-bold tracking-[-0.025em]">Guías firmadas</h2>
        {posts.length === 0
          ? <p class="mt-4 text-base leading-7 text-muted">Todavía no hay guías publicadas con esta firma.</p>
          : (
            <ul class="mt-8 flex flex-col">
              {posts.map((post) => (
                <li class="border-t border-line py-6">
                  <p class="font-mono text-[13px] text-muted">{formatDate(post.data.updatedAt)}</p>
                  <h3 class="mt-2 text-2xl font-semibold"><a href={`/blog/${post.id}`} class="hover:text-brand">{post.data.h1}</a></h3>
                </li>
              ))}
            </ul>
          )}
      </div>
    </section>
  </SiteFrame>
</BaseLayout>
