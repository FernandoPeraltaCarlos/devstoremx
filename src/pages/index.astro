---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import Technologies from '../components/sections/Technologies.astro';
import Process from '../components/sections/Process.astro';
import DashboardShowcase from '../components/sections/DashboardShowcase.astro';
import About from '../components/sections/About.astro';
import Video from '../components/sections/Video.astro';
import Faq from '../components/sections/Faq.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';
import StructuredData from '../components/seo/StructuredData.astro';
---
<BaseLayout>
  <StructuredData slot="head" />
  <!-- clip (not hidden) keeps the pinned timeline sticky while side reveals stay off-canvas. -->
  <main id="contenido" class="overflow-x-clip"><Hero /><Services /><Technologies /><Process /><DashboardShowcase /><About /><Video /><Faq /><Contact /></main>
  <Footer />
</BaseLayout>
