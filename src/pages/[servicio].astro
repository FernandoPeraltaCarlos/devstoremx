---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import SiteFrame from '../components/content/SiteFrame.astro';
import ServiceHero from '../components/content/ServiceHero.astro';
import { services } from '../data/landing';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import RelatedPosts from '../components/sections/RelatedPosts.astro';
import RelatedServices from '../components/sections/RelatedServices.astro';
import Faq from '../components/sections/Faq.astro';
import Contact from '../components/sections/Contact.astro';

export async function getStaticPaths() {
  const entries = await getCollection('servicios');
  return entries.map((entry) => ({ params: { servicio: entry.id }, props: { id: entry.id } }));
}

const { id } = Astro.props;
const entries = await getCollection('servicios');
const entry = entries.find((item) => item.id === id);
if (!entry) throw new Error(`Servicio no encontrado: ${id}`);
const { Content } = await render(entry);
const relatedPosts = (await getCollection('blog'))
  .filter((post) => post.data.relatedService === entry.id || post.data.relatedServices.includes(entry.id))
  .sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());
const related = entry.data.relatedServices.flatMap((relatedId) => {
  const match = entries.find((item) => item.id === relatedId);
  return match ? [match] : [];
});
const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Servicios', href: '/#servicios' },
  { name: entry.data.title, href: `/${entry.id}` },
];
const card = services.find((service) => service.href === `/${entry.id}`);
if (!card) throw new Error(`Falta el servicio ${entry.id} en src/data/landing.ts`);
// Cada "## Título" del Markdown se muestra como una sección: título a la izquierda, texto a la derecha.
const sections = (entry.rendered?.html ?? '')
  .split(/(?=<h2[\s>])/)
  .map((chunk) => chunk.match(/^<h2([^>]*)>([\s\S]*?)<\/h2>\s*([\s\S]*)$/))
  .flatMap((match) => (match ? [{ attrs: match[1], title: match[2], body: match[3] }] : []));
const sectionId = (attrs: string) => attrs.match(/id="([^"]+)"/)?.[1];
---
<BaseLayout title={entry.data.metaTitle} description={entry.data.metaDescription}>
  <StructuredData
    slot="head"
    title={entry.data.metaTitle}
    description={entry.data.metaDescription}
    variant="service"
    serviceName={entry.data.title}
    serviceType={entry.data.h1}
    faqs={entry.data.faqs}
    breadcrumbs={crumbs}
  />
  <SiteFrame>
    <ServiceHero
      crumbs={crumbs}
      title={entry.data.h1}
      lede={entry.data.intro}
      name={entry.data.title}
      number={card.number}
      icon={card.icon}
      highlights={entry.data.highlights}
    />
    <article class="bg-paper pt-16 pb-8 sm:pt-20 lg:pt-24 lg:pb-12">
      <div class="container-page">
        <div class="service-prose">
          {sections.length > 0
            ? sections.map((section) => (
                <section class="svc-section">
                  <h2 id={sectionId(section.attrs)} set:html={section.title} />
                  <div class="svc-body" set:html={section.body} />
                </section>
              ))
            : <Content />}
        </div>
      </div>
    </article>
    <ProcessSteps />
    <Faq
      items={entry.data.faqs}
      title={`Preguntas sobre ${entry.data.title}`}
      description="Respuestas concretas de este servicio. El costo se define en la propuesta, no en esta página."
    />
    <RelatedPosts posts={relatedPosts} />
    <RelatedServices entries={related} />
    <Contact />
  </SiteFrame>
</BaseLayout>
