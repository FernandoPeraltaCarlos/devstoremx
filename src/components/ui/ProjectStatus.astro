---
import Icon from './Icon.astro';
const rows = [
  { label: 'Diseño de pantallas', status: 'Aprobado', icon: 'check', color: 'text-[#4ade80]', badge: 'bg-[#0c2a1a] text-[#4ade80]' },
  { label: 'Desarrollo de páginas', status: 'En progreso', icon: 'progress', color: 'text-periwinkle spin-once', badge: 'bg-[#1a2350] text-periwinkle' },
  { label: 'Integración de pagos', status: 'Pendiente', icon: 'circle', color: 'text-muted-dark', badge: 'bg-[#2e2108] text-[#f5b544]' },
];
---
<div data-reveal="right" class="rounded-[10px] border border-line-dark bg-panel p-5 sm:p-6">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line-dark pb-3"><span class="text-[15px] font-semibold">Estado de tu proyecto</span><span class="font-mono text-xs text-muted-dark sm:text-[13px]">[Nombre del proyecto]</span></div>
  {rows.map((row, i) => <div data-reveal="right" data-reveal-delay={150 + i * 110} class:list={['flex items-center justify-between gap-2 py-3', i < 2 && 'border-b border-line-dark', i === 2 && 'pb-0']}>
    <span class="flex items-center gap-2 text-xs sm:gap-2.5 sm:text-[15px]"><Icon name={row.icon} size={18} class={`${row.color} shrink-0`} />{row.label}</span>
    <span class:list={['shrink-0 rounded px-2 py-[3px] text-xs font-medium sm:text-[13px]', row.badge]}>{row.status}</span>
  </div>)}
</div>
