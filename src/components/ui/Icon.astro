---
interface Props { name?: string; markup?: string; size?: number; class?: string; }
const { name = 'arrow', markup, size = 24, class: className = '' } = Astro.props;
const paths: Record<string, string> = {
  arrow: '<path d="M5 12h14M12 5l7 7-7 7"/>',
  person: '<circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>',
  image: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.09-3.09a2 2 0 0 0-2.82 0L6 21"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  progress: '<path d="M21 12a9 9 0 1 1-6.22-8.56"/>',
  circle: '<circle cx="12" cy="12" r="9"/>',
};
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true" set:html={markup ?? paths[name]} />
