---
interface Props { eyebrow: string; title: string; description?: string; dark?: boolean; centered?: boolean; class?: string; }
const { eyebrow, title, description, dark = false, centered = false, class: className = '' } = Astro.props;
---
<div class:list={[centered ? 'flex flex-col items-center gap-4 text-center' : 'flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-16', className]}>
  <div class:list={['flex flex-col gap-4', centered ? 'items-center' : 'max-w-[640px]']}>
    <span data-reveal class:list={['eyebrow', dark ? 'text-periwinkle' : 'text-brand']}>{eyebrow}</span>
    <h2 data-reveal="blur" data-reveal-delay="100" class="text-[32px] leading-[1.14] font-bold tracking-[-0.025em] sm:text-[40px] lg:text-5xl">{title}</h2>
  </div>
  {description && <p data-reveal data-reveal-delay="220" class:list={['text-base leading-7 sm:text-lg', centered ? 'max-w-[560px]' : 'max-w-[420px] lg:shrink-0 lg:basis-[35%]', dark ? 'text-muted-dark' : 'text-muted']}>{description}</p>}
</div>
