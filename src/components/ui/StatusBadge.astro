---
interface Props { status: 'aprobado' | 'en-progreso' | 'pendiente'; dark?: boolean; class?: string; }
const { status, dark = false, class: className = '' } = Astro.props;
const tones = {
  aprobado: { label: 'Aprobado', light: 'bg-success-soft text-success', dark: 'bg-success-soft-dark text-success-dark' },
  'en-progreso': { label: 'En progreso', light: 'bg-primary-soft text-brand', dark: 'bg-primary-soft-dark text-periwinkle' },
  pendiente: { label: 'Pendiente', light: 'bg-warning-soft text-warning', dark: 'bg-warning-soft-dark text-warning-dark' },
};
const tone = tones[status];
---
<span class:list={['shrink-0 rounded px-2 py-[3px] text-xs font-medium sm:text-[0.8125rem]', dark ? tone.dark : tone.light, className]}>{tone.label}</span>
