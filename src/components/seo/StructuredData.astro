---
import { defaultTitle, metaDescription, site } from '../../data/landing';
import { buildStructuredGraph, type StructuredInput } from '../../lib/structured-data';
import { canonicalPathname } from '../../lib/seo';

interface Props {
  title?: string;
  description?: string;
  variant?: StructuredInput['variant'];
  breadcrumbs?: StructuredInput['breadcrumbs'];
  faqs?: StructuredInput['faqs'];
  serviceName?: string;
  serviceType?: string;
  article?: StructuredInput['article'];
  howTo?: StructuredInput['howTo'];
  authorSlug?: string;
  blogPosts?: StructuredInput['blogPosts'];
}

const origin = (Astro.site ?? new URL(site.url)).origin;
const graph = buildStructuredGraph({
  origin,
  pathname: canonicalPathname(Astro.url.pathname),
  title: Astro.props.title ?? defaultTitle,
  description: Astro.props.description ?? metaDescription(),
  variant: Astro.props.variant ?? 'home',
  breadcrumbs: Astro.props.breadcrumbs,
  faqs: Astro.props.faqs,
  serviceName: Astro.props.serviceName,
  serviceType: Astro.props.serviceType,
  article: Astro.props.article,
  howTo: Astro.props.howTo,
  authorSlug: Astro.props.authorSlug,
  blogPosts: Astro.props.blogPosts,
});
const jsonLd = JSON.stringify(graph).replace(/</g, '\\u003c');
---
<script is:inline type="application/ld+json" set:html={jsonLd}></script>
