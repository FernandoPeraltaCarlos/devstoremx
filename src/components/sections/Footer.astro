---
import Logo from '../ui/Logo.astro';
import { footerServiceSlugs, navigation, publicValue, services, site } from '../../data/landing';

const footerServices = footerServiceSlugs.flatMap((slug) => {
  const service = services.find((item) => item.slug === slug);
  return service ? [service] : [];
});
const email = publicValue(site.email);
const phone = publicValue(site.phone);
const location = publicValue(site.location);
const onPrivacy = Astro.url.pathname.includes('aviso-de-privacidad');
---
<footer class="bg-night text-cloud">
  <div class="container-page flex min-h-[360px] flex-col justify-between gap-12 pt-14 pb-10 lg:pt-[72px]">
    <div class="flex flex-col justify-between gap-10 lg:flex-row lg:gap-16">
      <div data-reveal class="flex max-w-[360px] flex-col gap-4"><Logo class="text-xl" /><p class="text-[15px] leading-6 text-muted-dark">Diseñamos, desarrollamos y mantenemos tu presencia digital.</p></div>
      <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:gap-x-12 xl:gap-x-20">
        <nav data-reveal aria-label="Servicios" class="flex flex-col gap-3 text-[15px]"><span class="eyebrow text-muted-dark">Servicios</span>{footerServices.map((service) => <a href={service.href} class="hover:text-periwinkle">{service.title}</a>)}</nav>
        <nav data-reveal data-reveal-delay="100" aria-label="Agencia" class="flex flex-col gap-3 text-[15px]"><span class="eyebrow text-muted-dark">Agencia</span>{navigation.slice(1).map((item) => <a href={item.href} class="hover:text-periwinkle">{item.label}</a>)}<a href="/dashboard-cliente" class="hover:text-periwinkle">Dashboard de ejemplo</a><a href="/#contacto" class="hover:text-periwinkle">Contacto</a></nav>
        <div data-reveal data-reveal-delay="200" class="col-span-2 flex flex-col gap-3 text-[15px] sm:col-span-1"><span class="eyebrow text-muted-dark">Contacto</span><a href="/#contacto" class="hover:text-periwinkle">Formulario de contacto</a>{email && <a href={`mailto:${email}`} class="break-words hover:text-periwinkle">{email}</a>}{phone && <a href={`tel:${phone.replace(/[^\d+]/g, '')}`} class="hover:text-periwinkle">{phone}</a>}{location && <span>{location}</span>}</div>
      </div>
    </div>
    <div class="flex flex-col justify-between gap-4 border-t border-line-dark pt-6 text-sm text-muted-dark sm:flex-row"><span>© {new Date().getFullYear()} Devstoremx. Todos los derechos reservados.</span><a href="/aviso-de-privacidad" class="hover:text-periwinkle" aria-current={onPrivacy ? 'page' : undefined}>Aviso de privacidad</a></div>
  </div>
</footer>
