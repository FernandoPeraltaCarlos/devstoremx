---
import BrandMark from '../ui/BrandMark.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ContactForm from '../interactive/ContactForm';
import { site } from '../../data/landing';
---
<section id="contacto" class="section-space bg-paper lg:min-h-[940px]">
  <div class="container-page grid gap-10 lg:grid-cols-2 lg:gap-20">
    <figure data-reveal="left" class="order-2 flex min-w-0 flex-col self-start overflow-hidden rounded-[10px] bg-night lg:order-1">
      {site.contactImage && <img src={site.contactImage} alt="Ilustración de bloques geométricos azules de devstoremx" width="1080" height="1920" loading="lazy" decoding="async" class="block h-auto max-h-[748px] w-full object-contain" />}
      <figcaption class="flex items-center gap-4 px-5 py-5 sm:px-6"><BrandMark /><p class="text-sm leading-6 text-cloud sm:text-base">Todo empieza con una llamada para entender tu proyecto.</p></figcaption>
    </figure>
    <div class="order-1 flex min-w-0 flex-col gap-8 lg:order-2">
      <SectionHeading eyebrow="Contacto" title="Cuéntanos de tu proyecto." class="lg:flex-col lg:items-start lg:gap-4 [&_h2]:lg:text-[44px]" />
      <p data-reveal data-reveal-delay="120" class="-mt-4 text-lg leading-7 text-muted">Déjanos tus datos y agendamos la llamada de acercamiento.</p>
      <div data-reveal data-reveal-delay="240"><ContactForm endpoint={site.formEndpoint} whatsappUrl={site.whatsappUrl} linkedinUrl={site.linkedinUrl} client:visible /></div>
    </div>
  </div>
</section>
