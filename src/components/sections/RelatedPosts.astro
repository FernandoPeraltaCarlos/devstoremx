---
import type { CollectionEntry } from 'astro:content';
import { memberSlug, team } from '../../data/landing';
import { formatDate } from '../../lib/seo';
import { readingMinutes } from '../../lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
const [lead, ...rest] = posts;
const leadAuthor = team.find((member) => memberSlug(member.image) === lead?.data.author);
---
{lead && (
  <section class="section-space bg-paper" aria-labelledby="entradas">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-[640px]">
          <h2 id="entradas" class="text-[28px] leading-[1.16] font-bold tracking-[-0.025em] min-[400px]:text-[30px] sm:text-[40px]">Entradas relacionadas</h2>
          <p class="mt-4 max-w-[46ch] text-base leading-7 text-muted">Problemas que este servicio puede resolver y decisiones que conviene tomar antes de contratarlo.</p>
        </div>
        <a href="/blog" class="inline-flex min-h-11 items-center font-semibold text-brand hover:text-[#2f47cc]">Ver el blog</a>
      </div>
      <a href={`/blog/${lead.id}`} class="group mt-10 grid overflow-hidden rounded-[10px] border border-line bg-white lg:mt-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
        <img src={lead.data.heroImage} alt={lead.data.heroImageAlt} width="1200" height="630" loading="lazy" decoding="async" class="aspect-[1200/630] h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100" />
        <div class="flex min-w-0 flex-col justify-center px-6 py-7 sm:px-8 sm:py-9">
          <p class="text-[13px] leading-5 font-bold text-brand">{lead.data.category}</p>
          <h3 class="mt-3 text-[28px] leading-[1.2] font-bold tracking-[-0.03em] text-balance group-hover:text-brand sm:text-[34px]">{lead.data.h1}</h3>
          <p class="mt-4 line-clamp-3 max-w-[46ch] text-base leading-7 text-muted">{lead.data.metaDescription}</p>
          <p class="mt-6 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
            <span class="font-semibold text-ink">{leadAuthor?.name ?? 'Fernando Peralta'}</span>
            <time datetime={lead.data.publishedAt.toISOString()}>{formatDate(lead.data.publishedAt)}</time>
            <span>{readingMinutes(lead.body)} min de lectura</span>
          </p>
        </div>
      </a>
      {rest.length > 0 && (
        <ul class="mt-8 border-b border-line">
          {rest.map((post) => (
            <li class="border-t border-line">
              <a href={`/blog/${post.id}`} class="group grid grid-cols-[88px_minmax(0,1fr)] items-center gap-4 py-5 sm:grid-cols-[120px_minmax(0,1fr)_auto] sm:gap-6">
                <img src={post.data.heroImage} alt="" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[1200/630] w-full rounded-md object-cover" />
                <span class="min-w-0">
                  <span class="block text-lg leading-6 font-semibold tracking-[-0.01em] group-hover:text-brand sm:text-xl">{post.data.h1}</span>
                  <span class="mt-1 line-clamp-2 block text-[15px] leading-6 text-muted">{post.data.metaDescription}</span>
                </span>
                <time class="hidden text-sm text-muted sm:block" datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}
