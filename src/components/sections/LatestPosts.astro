---
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import { memberSlug, team } from '../../data/landing';
import { formatDate } from '../../lib/seo';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() || a.id.localeCompare(b.id, 'es'))
  .slice(0, 4);
---
<section id="blog" class="section-space border-y border-line bg-white" aria-labelledby="ultimas-entradas">
  <div class="container-page">
    <SectionHeading eyebrow="Blog" title="Últimas entradas." description="Páginas web, tiendas, apps y cómo encargar un proyecto. Escritas por Fernando Peralta." />
    <div class="mt-10 grid gap-x-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-x-10">
      {posts.map((post, index) => {
        const author = team.find((member) => memberSlug(member.image) === post.data.author);
        return (
          <article data-reveal data-reveal-delay={index * 80} class="group border-t border-line">
            <a href={`/blog/${post.id}`} class="flex h-full flex-col py-8">
              <img src={post.data.heroImage} alt="" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[1200/630] w-full rounded-md object-cover" />
              <p class="mt-5 text-[13px] leading-5 font-bold tracking-[0.08em] text-brand uppercase">{post.data.category}</p>
              <h3 class="mt-3 text-[22px] leading-7 font-semibold tracking-[-0.01em] group-hover:text-brand">{post.data.h1}</h3>
              <p class="mt-3 line-clamp-3 text-[15px] leading-6 text-muted">{post.data.metaDescription}</p>
              <p class="mt-auto pt-5 text-sm text-muted">
                <span class="font-semibold text-ink">{author?.name ?? 'Devstoremx'}</span>
                <span aria-hidden="true"> · </span>
                <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
              </p>
            </a>
          </article>
        );
      })}
    </div>
    <a href="/blog" class="mt-2 inline-flex min-h-11 items-center font-semibold text-brand hover:text-[#2f47cc]">Ver todas las entradas</a>
  </div>
</section>
