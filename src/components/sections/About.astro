---
import SectionHeading from '../ui/SectionHeading.astro';
import TeamCard from '../ui/TeamCard.astro';
import { authorPath } from '../../data/authors';
import { memberSlug, team } from '../../data/landing';
---
<section id="nosotros" class="section-space bg-paper">
  <div class="container-page">
    <SectionHeading eyebrow="Sobre nosotros" title="Las personas detrás de tu proyecto." description="Fernando Peralta, fundador y Technical Lead, trabaja junto al equipo de desarrollo para dar forma a tu proyecto." />
    <div class="-mx-2 mt-10 grid grid-cols-1 gap-x-3 gap-y-6 min-[300px]:grid-cols-2 sm:-mx-4 sm:gap-6 lg:-mx-6 lg:mt-12 lg:grid-cols-4 xl:-mx-12">{team.map((member, i) => {
  const { bio: _bio, image, ...card } = member;
  return <TeamCard {...card} image={image} profile={authorPath(memberSlug(image))} delay={(i % 4) * 110} />;
})}</div>
  </div>
</section>
