---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { crumbs: { name: string; href: string }[]; title: string; lede: string }
const { crumbs, title, lede } = Astro.props;
---
<section class="bg-night text-cloud">
  <div class="container-page flex flex-col gap-6 pt-6 pb-16 sm:pt-8 lg:pb-20">
    <Breadcrumbs items={crumbs} />
    <div class="flex max-w-[760px] flex-col gap-5">
      <h1 class="text-[36px] leading-[1.08] font-bold tracking-[-0.03em] sm:text-5xl lg:text-[56px]">{title}</h1>
      <slot name="meta" />
      <p class="text-base leading-7 text-muted-dark sm:text-lg sm:leading-8">{lede}</p>
      <slot />
    </div>
  </div>
</section>
