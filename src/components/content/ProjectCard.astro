---
import { projectPath, type AuthorProject } from '../../lib/author-projects';
interface Props { project: AuthorProject }
const { project } = Astro.props;
---
<a href={projectPath(project)} class="group flex min-w-0 flex-col gap-4 rounded-[10px]">
  {project.cover && (
    <div class="overflow-hidden rounded-[10px] border border-line bg-white">
      <img src={project.cover.src} alt={project.cover.alt} width={project.cover.width} height={project.cover.height}
        loading="lazy" decoding="async"
        class:list={['aspect-[16/9] w-full transition-transform duration-200 motion-reduce:transition-none group-hover:scale-[1.02]', project.kind === 'personal' ? 'object-contain p-10' : 'object-cover']} />
    </div>
  )}
  <div class="flex flex-col gap-2">
    <h3 class="text-xl leading-7 font-bold tracking-[-0.02em] text-ink group-hover:text-brand">{project.content.title}</h3>
    <p class="text-[15px] leading-7 text-muted">{project.content.description}</p>
    <p class="mt-1 text-sm font-semibold text-brand">Conoce la solución<span class="sr-only">: {project.content.title}</span></p>
  </div>
</a>
