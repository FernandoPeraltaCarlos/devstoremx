---
import { absoluteUrl } from "@/lib/utils/absoluteUrl";
import config from ".astro/config.generated.json";
import { plainify, removeWhitespace } from "@/lib/utils/textConverter";
import { normalizeLocaleCode } from "@/lib/utils/i18nUtils";

// Destructure optional props with default fallback to config values
let {
  title,
  metaTitle,
  description,
  metaDescription,
  image = config.opengraph.image,
  twitterCard = config.opengraph.twitterCard,
  ogType = config.opengraph.ogType,
  imageAlt,
} = Astro.props;
const currentLocale = normalizeLocaleCode(Astro.currentLocale);
const defaultDescription =
  currentLocale === "en" ? config.site.descriptionEn : config.site.description;

// Get the possible value for title and description and remove any line breaks and extra spaces
title = plainify(
  metaTitle
    ? metaTitle
    : title
      ? `${title} | ${config.site.title}`
      : config.site.title,
);
title = removeWhitespace(title);

description = plainify(
  metaDescription
    ? metaDescription
    : description
      ? description
      : defaultDescription,
);

description = removeWhitespace(description);

// Generate the full URL for the current page
const pageUrl = new URL(Astro.url.pathname, config.site.baseUrl);
const ogLocale = currentLocale === "en" ? "en_US" : "es_MX";
const alternateLocale = currentLocale === "en" ? "es_MX" : "en_US";
const imageUrl = image ? absoluteUrl(image, Astro) : undefined;
const resolvedImageAlt = imageAlt || title;
const isDefaultImage = image === config.opengraph.image;
const imageExtension = imageUrl
  ?.split(".")
  .pop()
  ?.split(/[?#]/)[0]
  ?.toLowerCase();
const imageType =
  imageExtension === "jpg" || imageExtension === "jpeg"
    ? "image/jpeg"
    : imageExtension === "webp"
      ? "image/webp"
      : "image/png";
---

<!-------------------------
    Standard Open Graph
--------------------------->{
  imageUrl && <meta property="og:image" content={imageUrl} />
}
{imageUrl && <meta property="og:image:secure_url" content={imageUrl} />}
{imageUrl && <meta property="og:image:type" content={imageType} />}
{
  imageUrl && isDefaultImage && (
    <meta property="og:image:width" content="1200" />
  )
}
{
  imageUrl && isDefaultImage && (
    <meta property="og:image:height" content="630" />
  )
}
{imageUrl && <meta property="og:image:alt" content={resolvedImageAlt} />}
{title && <meta property="og:title" content={removeWhitespace(title)} />}
{
  config.site.title && (
    <meta
      property="og:site_name"
      content={removeWhitespace(config.site.title)}
    />
  )
}
{
  description && (
    <meta property="og:description" content={removeWhitespace(description)} />
  )
}
{ogType && <meta property="og:type" content={ogType} />}
{ogLocale && <meta property="og:locale" content={ogLocale} />}
<meta property="og:locale:alternate" content={alternateLocale} />
{pageUrl && <meta property="og:url" content={pageUrl} />}

<!------------------------
    Twitter Open Graph
-------------------------->
{title && <meta name="twitter:title" content={removeWhitespace(title)} />}
{
  description && (
    <meta name="twitter:description" content={removeWhitespace(description)} />
  )
}
{twitterCard && <meta name="twitter:card" content={twitterCard} />}
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
{imageUrl && <meta name="twitter:image:alt" content={resolvedImageAlt} />}
