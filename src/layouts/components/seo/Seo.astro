---
import {
  getLocaleUrlCTM,
  normalizeLocaleCode,
  supportedLanguages,
} from "@/lib/utils/i18nUtils";
import { getLocalizedPathnameCTM } from "@/lib/utils/localizedRouteResolver";
import { plainify, removeWhitespace } from "@/lib/utils/textConverter";
import config from ".astro/config.generated.json";

// Load the configuration
let {
  title,
  metaTitle,
  description,
  metaDescription,
  canonical,
  author = config.seo.author,
  robots = config.seo.robots,
  status,
} = Astro.props;

title = plainify(
  metaTitle
    ? metaTitle
    : title
      ? `${title} | ${config.site.title}`
      : config.site.title,
);

const currentLocale = normalizeLocaleCode(Astro.currentLocale);
const defaultDescription =
  currentLocale === "en" ? config.site.descriptionEn : config.site.description;

description = plainify(
  metaDescription
    ? metaDescription
    : description
      ? description
      : defaultDescription,
);

const toAbsoluteUrl = (url: string) => new URL(url, config.site.baseUrl).href;
const isErrorPage = status === 404;

const localizedCanonicalPath = await getLocalizedPathnameCTM(
  Astro.url.pathname,
  currentLocale,
  currentLocale,
);

const canonicalPath = canonical
  ? getLocaleUrlCTM(canonical, currentLocale)
  : getLocaleUrlCTM(localizedCanonicalPath, currentLocale);

canonical = isErrorPage ? undefined : toAbsoluteUrl(canonicalPath);

const alternateTags: Array<{ hreflang: string; href: string }> = [];
// If multilingual is enabled, add rel alternate link tags
if (
  config.settings.multilingual.enable &&
  !isErrorPage &&
  !canonicalPath.includes("blog/category/")
) {
  const alternateLinks = await Promise.all(
    supportedLanguages.map(async (lang) => ({
      hreflang: lang.languageCode,
      href: toAbsoluteUrl(
        getLocaleUrlCTM(
          await getLocalizedPathnameCTM(
            Astro.url.pathname,
            currentLocale,
            lang.languageCode,
          ),
          lang.languageCode,
        ),
      ),
    })),
  );

  alternateTags.push(...alternateLinks);

  alternateTags.push({
    hreflang: "x-default",
    href: toAbsoluteUrl(
      getLocaleUrlCTM(
        await getLocalizedPathnameCTM(
          Astro.url.pathname,
          currentLocale,
          config.settings.multilingual.defaultLanguage,
        ),
        config.settings.multilingual.defaultLanguage,
      ),
    ),
  });
}
---

{title && <title>{removeWhitespace(title)}</title>}
{
  description && (
    <meta name="description" content={removeWhitespace(description)} />
  )
}
{author && <meta name="author" content={removeWhitespace(author)} />}
{robots && <meta name="robots" content={removeWhitespace(robots)} />}
{canonical && <link rel="canonical" href={canonical} />}
{
  alternateTags &&
    alternateTags.map((tag) => (
      <link rel="alternate" hreflang={tag.hreflang} href={tag.href} />
    ))
}
