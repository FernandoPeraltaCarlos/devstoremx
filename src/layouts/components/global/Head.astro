---
import SEO from "@/components/seo/Seo.astro";
import JsonLD from "../widgets/JsonLD.astro";
import OpenGraph from "@/components/seo/OpenGraph.astro";
import config from ".astro/config.generated.json";
import { Font } from "astro:assets";
import fontsJson from "@/config/fonts.json";

const fontVariables = fontsJson.map((font) => font.cssVariable) as any[];
const preloadImages = (Astro.props.preloadImages as string[]) || [];
---

<head>
  <!------------
    General
-------------->
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/media/devstoremx.svg" />
  <link
    rel="icon"
    type="image/png"
    sizes="48x48"
    href="/media/favicon-48.png"
  />
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="/media/apple-touch-icon.png"
  />
  <link rel="manifest" href="/site.webmanifest" />
  <meta
    http-equiv="Content-Language"
    content={Astro.currentLocale ||
      config.settings.multilingual.defaultLanguage}
  />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, maximum-scale=5"
  />
  <script is:inline>
    document.documentElement.classList.add("reveal-ready");
  </script>
  <SEO {...Astro.props} />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: light)"
    content="#fff"
  />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: dark)"
    content="#000"
  />
  <meta name="generator" content={Astro.generator} />
  {
    config.head?.content && (
      // Injecting custom scripts such as Google Analytics, Google Tag Manager, etc. tracking code,
      // which should be placed in <head> tag
      <Fragment set:html={config.head?.content} />
    )
  }
  {Astro.props.status !== 404 && <OpenGraph {...Astro.props} />}
  {
    Astro.props.status !== 404 && (
      <JsonLD
        content={{
          ...Astro.props,
        }}
      />
    )
  }
  {preloadImages.map((src) => <link rel="preload" as="image" href={src} />)}
  <noscript>
    <style>
      [data-aos] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
        filter: none !important;
        clip-path: inset(0 0 0 0) !important;
      }
    </style>
  </noscript>
  <style>
    body {
      display: flex;
      flex-direction: column;
      min-height: 110vh;
    }
  </style>

  <!------------------
    Fonts
-------------------->
  {fontVariables.map((font) => <Font cssVariable={font} />)}
</head>
