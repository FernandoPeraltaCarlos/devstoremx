---
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { getEntrySlugCTM } from "@/lib/utils/i18nUtils";
import Icons from "@/helpers/Icons.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  content: CollectionEntry<"services">;
  index?: number;
  class?: string;
}

let { content, index = 0, class: className, ...rest } = Astro.props;

let { title, description, image, imagePosition } = content.data || {};

// Resolve URL from content id/collection
let slug =
  content.id && content.collection
    ? getEntrySlugCTM(content, Astro.currentLocale)
    : undefined;

const href = slug ?? "#";
---

<div
  class="group border-border-dark/15 relative border-b py-6 transition-colors lg:py-9"
  data-aos="fade-up"
  data-aos-delay={index * 80}
  data-aos-duration="600"
  data-service-card
  data-active={index === 0 ? "" : undefined}
  {...rest}>
  <div
    class="flex flex-col gap-4 md:flex-row md:items-start lg:gap-10 xl:gap-14">
    {/* Number */}
    <div
      class="text-text-default/70 w-auto shrink-0 pt-2 font-medium lg:pt-4 lg:text-lg">
      {String(index + 1).padStart(3, "0")}
    </div>

    {/* Title & Desc — pr reserves the floating image column so text never crosses it */}
    <div
      class="relative z-10 flex flex-1 flex-col justify-center lg:pr-[22rem] xl:pr-[28rem]">
      <h3 class="text-h3-sm md:text-h3 font-bold transition-colors">
        {title}
      </h3>

      {/* Description - always visible on mobile, expands for the active card */}
      <div
        class:list={[
          "grid transition-[grid-template-rows] duration-500 ease-in-out",
          "grid-rows-[1fr] lg:grid-rows-[0fr] lg:group-data-[active]:grid-rows-[1fr]",
        ]}>
        <div class="overflow-hidden">
          <p
            class="text-text-default/70 pt-4 pb-5 lg:pt-6.5 lg:text-lg xl:leading-7"
            set:html={markdownify(description || "")}
          />
        </div>
      </div>
    </div>

    {/* Arrow */}
    <div class="relative z-10 mt-2 flex shrink-0 lg:mt-2.5">
      <a
        href={href}
        aria-label={title}
        class:list={[
          "flex h-10 w-15 items-center justify-center rounded-sm border transition-all duration-300",
          "border-primary bg-primary text-white",
          "lg:border-border-dark/20 lg:text-dark lg:bg-transparent",
          "lg:group-data-[active]:border-primary lg:group-data-[active]:bg-primary lg:group-data-[active]:text-white",
        ]}>
        <Icons icon="ArrowRight" class="stroke-1.5 h-5 w-5" />
      </a>
    </div>
  </div>

  {
    image && (
      <div
        class:list={[
          "pointer-events-none absolute right-28 z-20 hidden aspect-[4/5] w-80 transform overflow-hidden rounded-xl shadow-2xl transition-all duration-600 lg:block xl:right-41 xl:w-97.5",
          {
            "top-8.5": imagePosition === "top" || !imagePosition,
            "bottom-8.5": imagePosition === "bottom",
            "top-1/2 -translate-y-1/2": imagePosition === "center",
          },
          "scale-95 opacity-0 group-data-[active]:scale-100 group-data-[active]:opacity-100",
        ]}>
        <OptimizedImage
          src={image}
          alt={title}
          width={900}
          height={1125}
          quality={100}
          class="h-full w-full object-contain"
        />
      </div>
    )
  }
  <a
    href={href}
    class="absolute inset-0 z-10 hidden size-full lg:block"
    aria-hidden="true">
  </a>
</div>

<script>
  // The active card is driven by real pointer movement instead of :hover.
  // Expanding a card resizes its neighbours, which moves rows under a still
  // cursor: with :hover that re-triggers the state in a loop (flicker + stuck
  // styles). "pointermove" only fires when the pointer actually moves.
  const initServiceCards = () => {
    const lists =
      document.querySelectorAll<HTMLElement>("[data-service-list]");

    lists.forEach((list) => {
      if (list.dataset.serviceListReady === "true") return;
      list.dataset.serviceListReady = "true";

      const cards = Array.from(
        list.querySelectorAll<HTMLElement>("[data-service-card]"),
      );
      if (cards.length === 0) return;

      const defaultCard = cards[0];
      let activeCard =
        cards.find((card) => card.hasAttribute("data-active")) ?? defaultCard;
      let lastX: number | null = null;
      let lastY: number | null = null;

      const setActiveCard = (card: HTMLElement) => {
        if (card === activeCard) return;
        activeCard.removeAttribute("data-active");
        card.setAttribute("data-active", "");
        activeCard = card;
      };

      list.addEventListener("pointermove", (event) => {
        if (event.pointerType !== "mouse") return;
        if (event.clientX === lastX && event.clientY === lastY) return;

        lastX = event.clientX;
        lastY = event.clientY;

        const card = (event.target as HTMLElement).closest<HTMLElement>(
          "[data-service-card]",
        );
        if (card) setActiveCard(card);
      });

      list.addEventListener("pointerleave", (event) => {
        if (event.pointerType !== "mouse") return;

        lastX = null;
        lastY = null;
        setActiveCard(defaultCard);
      });
    });
  };

  initServiceCards();
  document.addEventListener("astro:page-load", initServiceCards);
</script>
