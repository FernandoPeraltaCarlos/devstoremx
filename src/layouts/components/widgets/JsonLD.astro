---
import JsonLdGenerator from "@/lib/utils/JsonLdGenerator";
import { getLocaleUrlCTM, normalizeLocaleCode } from "@/lib/utils/i18nUtils";
import { getLocalizedPathnameCTM } from "@/lib/utils/localizedRouteResolver";
import { plainify } from "@/lib/utils/textConverter";
import config from ".astro/config.generated.json";

const { content } = Astro.props;
const currentLocale = normalizeLocaleCode(Astro.currentLocale);
const defaultDescription =
  currentLocale === "en" ? config.site.descriptionEn : config.site.description;
const localizedPath = await getLocalizedPathnameCTM(
  Astro.url.pathname,
  currentLocale,
  currentLocale,
);
const canonicalPath = content.canonical
  ? getLocaleUrlCTM(content.canonical, currentLocale)
  : getLocaleUrlCTM(localizedPath, currentLocale);
const canonical = new URL(canonicalPath, config.site.baseUrl).href;
const image = content.image || config.opengraph.image;

const jsonLdData = JsonLdGenerator({
  canonical,
  title: plainify(content.title || config.site.title),
  description: plainify(
    content.metaDescription || content.description || defaultDescription,
  ),
  image: image ? new URL(image, config.site.baseUrl).href : undefined,
  lang: currentLocale,
  pageType: content.pageType || "webpage",
  faqItems: content.faqItems || [],
  homepage: Boolean(content.homepage),
  pathname: canonicalPath,
  config,
});
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLdData)}
/>
