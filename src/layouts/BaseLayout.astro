---
import '../styles/global.css';
import { defaultTitle, metaDescription, ogImageAlt, site } from '../data/landing';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title = defaultTitle,
  description = metaDescription(),
  canonical,
  image = site.ogImage,
  imageAlt = ogImageAlt,
} = Astro.props;

const origin = Astro.site ?? site.url;
const canonicalHref = canonical ?? new URL(Astro.url.pathname, origin).href;
const imageHref = new URL(image, origin).href;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070d" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:site_name" content="devstoremx" />
    <meta property="og:image" content={imageHref} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageHref} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a href="#contenido" class="fixed top-4 left-4 z-50 -translate-y-24 rounded-md bg-white px-5 py-3 font-semibold text-brand focus:translate-y-0">Saltar al contenido</a>
    <div aria-hidden="true" class="scroll-progress pointer-events-none fixed inset-x-0 top-0 z-50 h-[3px] origin-left bg-gradient-to-r from-electric to-sky"></div>
    <slot />
    <script>
      import { setupViewportReveals } from '../scripts/viewport-reveal';
      setupViewportReveals();
    </script>
  </body>
</html>
